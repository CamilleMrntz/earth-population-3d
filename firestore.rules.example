rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // EXEMPLE DEV UNIQUEMENT — tout le monde peut lire/écrire.
    // Avant prod : restreindre par auth.uid, domaine, ou accès admin uniquement.
    match /species/{id} {
      allow read, write: if true;
    }
  }
}
